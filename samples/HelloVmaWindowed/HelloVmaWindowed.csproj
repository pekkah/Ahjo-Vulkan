<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Ahjo.Vulkan.Samples.HelloVmaWindowed</RootNamespace>
    <AssemblyName>HelloVmaWindowed</AssemblyName>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Ahjo.Vulkan\Ahjo.Vulkan.csproj" />
    <PackageReference Include="ppy.SDL3-CS" />
  </ItemGroup>

  <!-- Share the SDL3 window shim with the test project (#87 / #88). -->
  <ItemGroup>
    <Compile Include="..\..\tests\Ahjo.Vulkan.Tests\SdlWindow.cs" Link="SdlWindow.cs" />
  </ItemGroup>

  <ItemGroup>
    <SlangShader Include="Shaders\vma.slang" EntryPoint="vertexMain"   OutputName="vma.vert.spv" />
    <SlangShader Include="Shaders\vma.slang" EntryPoint="fragmentMain" OutputName="vma.frag.spv" />
  </ItemGroup>

</Project>
