<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Ahjo.Vulkan.Samples.AotSmoke</RootNamespace>
    <AssemblyName>AotSmoke</AssemblyName>
    <IsPackable>false</IsPackable>

    <!--
      Issue 28: prove the wrapper compiles + runs under Native AOT. The
      smoke run mirrors HeadlessTriangle (allocator + buffer + image +
      pipeline + cmd recorder + fence wait + PNG dump) so any reflection
      / dynamic-codegen creep in the wrapper surfaces at publish time
      rather than after a downstream consumer adopts AOT.
    -->
    <PublishAot>true</PublishAot>

    <!--
      Surface trim and AOT analyzers loud — every warning here is a
      compatibility regression we want to address rather than suppress.
    -->
    <IsTrimmable>true</IsTrimmable>
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
    <TreatWarningsAsErrors Condition="'$(CI)' == 'true'">true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Ahjo.Vulkan\Ahjo.Vulkan.csproj" />
    <ProjectReference Include="..\..\src\Ahjo.Vulkan.Utilities\Ahjo.Vulkan.Utilities.csproj" />

    <!--
      Issue 166. This is the reference that makes the ILC run cover the
      Slang binding: the smoke exe compiles its own shader at startup, so
      any reflection or dynamic codegen on that path fails the publish
      instead of failing a downstream consumer who adopted AOT.
    -->
    <ProjectReference Include="..\..\src\Ahjo.Vulkan.Slang\Ahjo.Vulkan.Slang.csproj" />
  </ItemGroup>

  <!--
    The shader Program.cs actually renders with, compiled at run time by
    Ahjo.Vulkan.Slang. CopyToPublishDirectory is explicit because the
    publish pass does not inherit CopyToOutputDirectory for None items,
    and an AOT exe that cannot find its shader proves nothing.
  -->
  <ItemGroup>
    <None Include="Shaders\triangle.slang"
          Link="Shaders\triangle.slang"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
