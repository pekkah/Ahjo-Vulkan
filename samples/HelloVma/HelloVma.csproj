<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Ahjo.Vulkan.Samples.HelloVma</RootNamespace>
    <AssemblyName>HelloVma</AssemblyName>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Ahjo.Vulkan\Ahjo.Vulkan.csproj" />
    <ProjectReference Include="..\..\src\Ahjo.Vulkan.Utilities\Ahjo.Vulkan.Utilities.csproj" />
  </ItemGroup>

  <ItemGroup>
    <SlangShader Include="Shaders\vma.slang" EntryPoint="vertexMain"   OutputName="vma.vert.spv" />
    <SlangShader Include="Shaders\vma.slang" EntryPoint="fragmentMain" OutputName="vma.frag.spv" />
  </ItemGroup>

</Project>
