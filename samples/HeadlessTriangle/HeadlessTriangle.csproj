<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Ahjo.Vulkan.Samples.HeadlessTriangle</RootNamespace>
    <AssemblyName>HeadlessTriangle</AssemblyName>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Ahjo.Vulkan\Ahjo.Vulkan.csproj" />
    <ProjectReference Include="..\..\src\Ahjo.Vulkan.Utilities\Ahjo.Vulkan.Utilities.csproj" />
  </ItemGroup>

  <ItemGroup>
    <SlangShader Include="Shaders\triangle.slang" EntryPoint="vertexMain"   OutputName="triangle.vert.spv" />
    <SlangShader Include="Shaders\triangle.slang" EntryPoint="fragmentMain" OutputName="triangle.frag.spv" />
  </ItemGroup>

</Project>
