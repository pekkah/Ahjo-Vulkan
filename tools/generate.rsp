--file
native/include/vulkan/vulkan.h
--include-directory
native/include
--namespace
Ahjo.Vulkan.Native
--methodClassName
Vk
--libraryPath
vulkan-1
--output
src/Ahjo.Vulkan.Native/Generated
--output-mode
CSharp
--language
c
--config
latest-codegen
generate-helper-types
generate-file-scoped-namespaces
generate-unmanaged-constants
generate-disable-runtime-marshalling
generate-aggressive-inlining
exclude-enum-operators
strip-enum-member-type-name
multi-file
--define-macro
VK_USE_PLATFORM_WIN32_KHR
--define-macro
VK_USE_PLATFORM_XLIB_KHR
--define-macro
VK_USE_PLATFORM_WAYLAND_KHR
--define-macro
VK_USE_PLATFORM_METAL_EXT
--define-macro
VK_USE_PLATFORM_ANDROID_KHR
--remap
size_t=nuint
VkBool32=uint
--with-type
VkFlags=uint
VkFlags64=ulong
--with-access-specifier
*=public
