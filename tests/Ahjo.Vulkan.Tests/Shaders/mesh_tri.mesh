#version 450
#extension GL_EXT_mesh_shader : require

// Emits the same hard-coded NDC triangle as triangle.vert — bottom-left,
// bottom-right, top-center — so the mesh and classic paths are visually
// comparable. One workgroup, one primitive, three vertices; no inputs at
// all, which is the point: a mesh shader has no vertex-input stage.
//
// uScale is a real specialization constant so
// GraphicsPipelineBuilder.WithMeshSpecialization has something to bind to;
// its default of 1.0 leaves the emitted triangle identical to triangle.vert.

layout(local_size_x = 1) in;
layout(triangles, max_vertices = 3, max_primitives = 1) out;

layout(constant_id = 0) const float uScale = 1.0;

const vec2 positions[3] = vec2[](
    vec2(-0.5, -0.5),
    vec2( 0.5, -0.5),
    vec2( 0.0,  0.5)
);

void main() {
    SetMeshOutputsEXT(3, 1);
    gl_MeshVerticesEXT[0].gl_Position = vec4(positions[0] * uScale, 0.0, 1.0);
    gl_MeshVerticesEXT[1].gl_Position = vec4(positions[1] * uScale, 0.0, 1.0);
    gl_MeshVerticesEXT[2].gl_Position = vec4(positions[2] * uScale, 0.0, 1.0);
    gl_PrimitiveTriangleIndicesEXT[0] = uvec3(0, 1, 2);
}
