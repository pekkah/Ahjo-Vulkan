#version 450

// Tiny zero-fill compute shader. Writes its global invocation index
// (cast to uint) at the corresponding offset in a storage buffer.
// Fixture for ComputePipelineBuilder + (later) CommandRecorder.Dispatch.

layout(local_size_x = 64) in;

layout(set = 0, binding = 0) buffer Out {
    uint values[];
} buf;

// std430 is explicit: Slang's GLSL frontend lays push constants out std140
// unless told otherwise (glslc used std430). See tools/CLAUDE.md.
layout(push_constant, std430) uniform Pc {
    uint count;
} pc;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i < pc.count) {
        buf.values[i] = i;
    }
}
