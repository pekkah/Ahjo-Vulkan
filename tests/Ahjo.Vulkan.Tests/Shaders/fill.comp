#version 450

// Tiny zero-fill compute shader. Writes its global invocation index
// (cast to uint) at the corresponding offset in a storage buffer.
// Fixture for ComputePipelineBuilder + (later) CommandRecorder.Dispatch.

layout(local_size_x = 64) in;

layout(set = 0, binding = 0) buffer Out {
    uint values[];
} buf;

layout(push_constant) uniform Pc {
    uint count;
} pc;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i < pc.count) {
        buf.values[i] = i;
    }
}
