<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Ahjo.Vulkan.Tests</RootNamespace>
    <AssemblyName>Ahjo.Vulkan.Tests</AssemblyName>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="ppy.SDL3-CS" />
  </ItemGroup>

  <ItemGroup>
    <None Update="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Ahjo.Vulkan\Ahjo.Vulkan.csproj" />
    <ProjectReference Include="..\..\src\Ahjo.Vulkan.Utilities\Ahjo.Vulkan.Utilities.csproj" />
  </ItemGroup>

  <!--
    The declared-tier mechanism (issue #158), shared by every suite that
    touches Vulkan so each `dotnet test` carries its own proof that the
    lane's AHJO_VULKAN_TIER was actually met. Ahjo.Vulkan.Ktx.Native.Tests
    deliberately does not link these — its contract is to pass with no
    loader and no ICD. See docs/ci-coverage.md.
  -->
  <ItemGroup>
    <Compile Include="..\Shared\*.cs" LinkBase="Shared" />
  </ItemGroup>

  <!--
    Compile every .vert/.frag/.comp shader in Shaders/ to .spv via glslc
    before the build copies test content. The output lands next to the
    test DLL as "Shaders/<name>.spv" so SpirvBlob.Load(path) can find it
    relative to the binary directory.

    Skipped (with a build message) when glslc isn't on PATH so the suite
    still builds in environments without the Vulkan SDK — the tests
    that need real SPIR-V skip themselves at runtime.
  -->
  <ItemGroup>
    <_ShaderSource Include="Shaders\*.vert;Shaders\*.frag;Shaders\*.comp" />
  </ItemGroup>

  <Target Name="CompileShaders" AfterTargets="Build" Inputs="@(_ShaderSource)" Outputs="@(_ShaderSource->'$(OutputPath)Shaders\%(Filename)%(Extension).spv')">
    <PropertyGroup>
      <_GlslcExe Condition="'$(_GlslcExe)' == '' and '$(VULKAN_SDK)' != ''">$(VULKAN_SDK)\Bin\glslc.exe</_GlslcExe>
      <_GlslcExe Condition="'$(_GlslcExe)' == ''">glslc</_GlslcExe>
    </PropertyGroup>
    <MakeDir Directories="$(OutputPath)Shaders" />
    <Exec Command="&quot;$(_GlslcExe)&quot; &quot;%(_ShaderSource.FullPath)&quot; -o &quot;$(OutputPath)Shaders\%(_ShaderSource.Filename)%(_ShaderSource.Extension).spv&quot;"
          IgnoreExitCode="false"
          ContinueOnError="WarnAndContinue" />
  </Target>

</Project>
