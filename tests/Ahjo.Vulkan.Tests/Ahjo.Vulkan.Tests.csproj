<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Ahjo.Vulkan.Tests</RootNamespace>
    <AssemblyName>Ahjo.Vulkan.Tests</AssemblyName>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Microsoft.Testing.Extensions.CrashDump" />
    <PackageReference Include="ppy.SDL3-CS" />
    <PackageReference Include="Microsoft.Diagnostics.Tracing.TraceEvent" />
  </ItemGroup>

  <ItemGroup>
    <None Update="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Ahjo.Vulkan\Ahjo.Vulkan.csproj" />
    <ProjectReference Include="..\..\src\Ahjo.Vulkan.Utilities\Ahjo.Vulkan.Utilities.csproj" />
  </ItemGroup>

  <!--
    The declared-tier mechanism (issue #158), shared by every suite that
    touches Vulkan so each `dotnet test` carries its own proof that the
    lane's AHJO_VULKAN_TIER was actually met. Ahjo.Vulkan.Ktx.Native.Tests
    deliberately does not link these — its contract is to pass with no
    loader and no ICD. See docs/ci-coverage.md.
  -->
  <ItemGroup>
    <Compile Include="..\Shared\*.cs" LinkBase="Shared" />
  </ItemGroup>

  <!--
    Compiled by the shared step (tools/msbuild/Ahjo.Vulkan.SlangShaders.targets).
    The GLSL stays GLSL on purpose (spec A5: translating the gl_VertexIndex
    fixtures to Slang would add DrawParameters).
  -->
  <ItemGroup>
    <SlangShader Include="Shaders\*.vert;Shaders\*.frag;Shaders\*.comp" />
    <SlangShader Include="Shaders\mesh_tri.slang" EntryPoint="meshMain" OutputName="mesh_tri.mesh.spv" />
    <SlangShader Include="Shaders\mesh_tri.slang" EntryPoint="taskMain" OutputName="mesh_tri.task.spv" />
  </ItemGroup>

</Project>
