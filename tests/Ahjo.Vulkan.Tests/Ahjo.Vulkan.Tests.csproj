<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Ahjo.Vulkan.Tests</RootNamespace>
    <AssemblyName>Ahjo.Vulkan.Tests</AssemblyName>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="ppy.SDL3-CS" />
  </ItemGroup>

  <ItemGroup>
    <None Update="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Ahjo.Vulkan\Ahjo.Vulkan.csproj" />
    <ProjectReference Include="..\..\src\Ahjo.Vulkan.Utilities\Ahjo.Vulkan.Utilities.csproj" />
  </ItemGroup>

  <!--
    The declared-tier mechanism (issue #158), shared by every suite that
    touches Vulkan so each `dotnet test` carries its own proof that the
    lane's AHJO_VULKAN_TIER was actually met. Ahjo.Vulkan.Ktx.Native.Tests
    deliberately does not link these — its contract is to pass with no
    loader and no ICD. See docs/ci-coverage.md.
  -->
  <ItemGroup>
    <Compile Include="..\Shared\*.cs" LinkBase="Shared" />
  </ItemGroup>

  <!--
    Compile every .vert/.frag/.comp shader in Shaders/ to .spv via glslc
    before the build copies test content. The output lands next to the
    test DLL as "Shaders/<name>.spv" so SpirvBlob.Load(path) can find it
    relative to the binary directory.

    Skipped (with a build message) when glslc isn't on PATH so the suite
    still builds in environments without the Vulkan SDK — the tests
    that need real SPIR-V skip themselves at runtime.
  -->
  <ItemGroup>
    <_ShaderSource Include="Shaders\*.vert;Shaders\*.frag;Shaders\*.comp" />
  </ItemGroup>

  <Target Name="CompileShaders" AfterTargets="Build" Inputs="@(_ShaderSource)" Outputs="@(_ShaderSource->'$(OutputPath)Shaders\%(Filename)%(Extension).spv')">
    <PropertyGroup>
      <_GlslcExe Condition="'$(_GlslcExe)' == '' and '$(VULKAN_SDK)' != ''">$(VULKAN_SDK)\Bin\glslc.exe</_GlslcExe>
      <_GlslcExe Condition="'$(_GlslcExe)' == ''">glslc</_GlslcExe>
    </PropertyGroup>
    <MakeDir Directories="$(OutputPath)Shaders" />
    <Exec Command="&quot;$(_GlslcExe)&quot; &quot;%(_ShaderSource.FullPath)&quot; -o &quot;$(OutputPath)Shaders\%(_ShaderSource.Filename)%(_ShaderSource.Extension).spv&quot;"
          IgnoreExitCode="false"
          ContinueOnError="WarnAndContinue" />
  </Target>


  <!--
    Mesh-shading fixtures compile through a SECOND target, not the one above.
    GL_EXT_mesh_shader needs SPIR-V 1.4, so these need an explicit
    target-env flag; the existing CompileShaders target passes none (so it
    defaults to vulkan1.0) and must keep doing so, or every pre-existing .spv
    output changes.

    vulkan1.2 (SPIR-V 1.5), not vulkan1.3: at vulkan1.3 glslang emits
    OpExecutionModeId LocalSizeId for the workgroup size, which
    VUID-RuntimeSpirv-LocalSizeId-06434 makes conditional on the maintenance4
    feature. That would force every consumer of these fixtures to enable a
    feature unrelated to mesh shading. vulkan1.2 emits plain OpExecutionMode
    LocalSize and clears the SPIR-V 1.4 floor GL_EXT_mesh_shader actually
    needs, so the fixtures require nothing beyond VK_EXT_mesh_shader itself. Same glslc resolution and same
    ContinueOnError="WarnAndContinue" skip-when-missing behavior.
  -->
  <ItemGroup>
    <_MeshShaderSource Include="Shaders\*.mesh;Shaders\*.task" />
  </ItemGroup>

  <Target Name="CompileMeshShaders" AfterTargets="Build" Inputs="@(_MeshShaderSource)" Outputs="@(_MeshShaderSource->'$(OutputPath)Shaders\%(Filename)%(Extension).spv')">
    <PropertyGroup>
      <_GlslcExe Condition="'$(_GlslcExe)' == '' and '$(VULKAN_SDK)' != ''">$(VULKAN_SDK)\Bin\glslc.exe</_GlslcExe>
      <_GlslcExe Condition="'$(_GlslcExe)' == ''">glslc</_GlslcExe>
    </PropertyGroup>
    <MakeDir Directories="$(OutputPath)Shaders" />
    <Exec Command="&quot;$(_GlslcExe)&quot; --target-env=vulkan1.2 &quot;%(_MeshShaderSource.FullPath)&quot; -o &quot;$(OutputPath)Shaders\%(_MeshShaderSource.Filename)%(_MeshShaderSource.Extension).spv&quot;"
          IgnoreExitCode="false"
          ContinueOnError="WarnAndContinue" />
  </Target>

</Project>
