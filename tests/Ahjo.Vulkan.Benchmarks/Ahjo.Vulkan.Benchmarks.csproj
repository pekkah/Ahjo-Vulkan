<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Ahjo.Vulkan.Benchmarks</RootNamespace>
    <AssemblyName>Ahjo.Vulkan.Benchmarks</AssemblyName>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <!-- BDN runs in Release; keep Debug build cheap. -->
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Ahjo.Vulkan\Ahjo.Vulkan.csproj" />
    <!-- DlssEvaluateBenchmarks only. Host-gated: its [GlobalSetup] throws
         without an NVIDIA GPU, a DLSS-capable driver and a consumer-supplied
         nvngx_dlss.dll, which is why it is its own class (issue #218). -->
    <ProjectReference Include="..\..\src\Ahjo.Vulkan.Ngx\Ahjo.Vulkan.Ngx.csproj" />
  </ItemGroup>

  <!--
    The benchmarks need real vert + frag, compute and mesh modules; they
    reuse the test project's shader sources rather than duplicating them
    here. Compiled by the shared step
    (tools/msbuild/Ahjo.Vulkan.SlangShaders.targets), same items as the
    test csproj.
  -->
  <ItemGroup>
    <SlangShader Include="..\Ahjo.Vulkan.Tests\Shaders\triangle.vert;..\Ahjo.Vulkan.Tests\Shaders\triangle.frag;..\Ahjo.Vulkan.Tests\Shaders\spec_fill.comp" />
    <SlangShader Include="..\Ahjo.Vulkan.Tests\Shaders\mesh_tri.slang" EntryPoint="meshMain" OutputName="mesh_tri.mesh.spv" />
    <SlangShader Include="..\Ahjo.Vulkan.Tests\Shaders\mesh_tri.slang" EntryPoint="taskMain" OutputName="mesh_tri.task.spv" />
  </ItemGroup>

</Project>
