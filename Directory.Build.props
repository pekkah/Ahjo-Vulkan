<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AnalysisLevel>latest</AnalysisLevel>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Pinned Vulkan-Headers tag. Bump deliberately; the generated
         bindings are committed and a regen run is required after a bump.
         See https://github.com/KhronosGroup/Vulkan-Headers/releases. -->
    <VulkanHeadersVersion>vulkan-sdk-1.4.341.0</VulkanHeadersVersion>
    <!-- Pinned VulkanMemoryAllocator tag. Independent cadence from
         VulkanHeadersVersion. Bump deliberately; the generated bindings are
         committed and a regen run is required after a bump.
         See https://github.com/GPUOpen-LibrariesAndSDKs/VulkanMemoryAllocator/releases. -->
    <VmaVersion>v3.3.0</VmaVersion>
    <!-- Pinned KTX-Software (libktx) tag. Independent cadence from the two
         above. Bump deliberately; the generated bindings are committed and
         a regen run is required after a bump.
         See https://github.com/KhronosGroup/KTX-Software/releases. -->
    <KtxVersion>v4.4.2</KtxVersion>
    <!-- Pinned Slang (shader-slang) release tag. Independent cadence from
         the three above. Bump deliberately; the generated bindings are
         committed and a regen run is required after a bump.
         See https://github.com/shader-slang/slang/releases.

         Unlike VMA and libktx, Slang is NOT built from source: its build
         pulls LLVM and a full downstream-compiler tree, and the artifact we
         would produce is the one Khronos/NVIDIA already publish and test.
         We consume the prebuilt per-RID release archive instead (spec D3),
         so the SHA-256 of each archive is pinned here and verified before
         anything is extracted. A SlangVersion bump therefore requires
         re-recording BOTH hashes and a regen run — the version pin alone
         does not describe the input.

         Asset URLs are derived from the tag:
           https://github.com/shader-slang/slang/releases/download/$(SlangVersion)/slang-$(SlangVersion.TrimStart('v'))-windows-x86_64.zip
           https://github.com/shader-slang/slang/releases/download/$(SlangVersion)/slang-$(SlangVersion.TrimStart('v'))-linux-x86_64.tar.gz -->
    <SlangVersion>v2026.14.1</SlangVersion>
    <SlangWinX64Sha256>5ed0a59d650a0af0aca45d5db4e083b3d8fb5cea05748747dd95dfbe9c580658</SlangWinX64Sha256>
    <SlangLinuxX64Sha256>21f2d7847385a770e569fb61b1507a7794d742d97850bce0432bff0032ca005f</SlangLinuxX64Sha256>
    <!-- Pinned NVIDIA DLSS (NGX) SDK tag. Independent cadence from the four
         above. See https://github.com/NVIDIA/DLSS/releases.

         Nothing is cloned or built from this repo: tools/setup-ngx.ps1
         fetches individual files (headers, the static NGX client library the
         shim links, the licence text, and — for local development only — the
         nvngx_dlss feature DLL) by raw URL at this tag and verifies each one
         against native/ngx/pins.sha256. A bump therefore means re-running
         that script with -UpdatePins and committing the new pins file.

         The feature DLL is never packed: consumers supply it (issue #214).

         Like the four pins above, a bump here also requires a regen run
         (`/regen-bindings`): the NGX headers under native/ngx/include/ are
         committed and src/Ahjo.Vulkan.Ngx.Native/Generated/ is derived from
         them, so moving the tag without regenerating leaves the bindings
         describing the old API. -->
    <NgxVersion>v310.7.0</NgxVersion>
    <!-- The libktx feature set, defined ONCE. The local host build
         (BuildKtxForHost) and every CI matrix job invoke that same target,
         so these flags cannot drift between a developer's binary and the
         one that ships.

         Everything that is not "read a KTX2 container and transcode Basis
         Universal" is off: TOOLS/TESTS drag in external/fmt,
         external/cxxopts and a gtest tree, JNI/PY produce bindings for
         other languages, and GL_UPLOAD/VK_UPLOAD would each add a graphics
         API dependency to a library whose contract here ends at bytes.

         Not overridden, deliberately: astc-encoder's ISA backend, which
         KTX defaults to AVX2 on x86_64. That is what Khronos' own release
         binaries are built with, so matching it keeps us on the
         configuration upstream tests. -DASTCENC_ISA_SSE41=ON is the escape
         hatch if a pre-2013 CPU ever has to run this. -->
    <KtxCMakeFeatureFlags>-DBUILD_SHARED_LIBS=ON -DKTX_FEATURE_TESTS=OFF -DKTX_FEATURE_TOOLS=OFF -DKTX_FEATURE_DOC=OFF -DKTX_FEATURE_JNI=OFF -DKTX_FEATURE_PY=OFF -DKTX_FEATURE_GL_UPLOAD=OFF -DKTX_FEATURE_VK_UPLOAD=OFF -DKTX_FEATURE_LOADTEST_APPS=OFF</KtxCMakeFeatureFlags>
    <RepositoryRoot>$(MSBuildThisFileDirectory)</RepositoryRoot>
    <NativeDir>$(RepositoryRoot)native\</NativeDir>
    <ToolsDir>$(RepositoryRoot)tools\</ToolsDir>
  </PropertyGroup>

  <!--
    Package metadata shared by all publishable projects.

    Defaults: nothing is packable unless the project explicitly opts in with
    <IsPackable>true</IsPackable> + <PackageId>. The publishable projects are
    src/Ahjo.Vulkan (Ahjo.Vulkan), src/Ahjo.Vulkan.Native
    (Ahjo.Vulkan.Native), src/Ahjo.Vulkan.Vma.Native
    (Ahjo.Vulkan.Vma.Native), src/Ahjo.Vulkan.Ktx.Native
    (Ahjo.Vulkan.Ktx.Native), src/Ahjo.Vulkan.Slang.Native
    (Ahjo.Vulkan.Slang.Native), src/Ahjo.Vulkan.Slang
    (Ahjo.Vulkan.Slang) and src/Ahjo.Vulkan.Ngx.Native
    (Ahjo.Vulkan.Ngx.Native) — seven in all. Samples, tests, and the
    Utilities helper library stay unpublished.

    Version: the publish workflow (.github/workflows/publish.yml) overrides
    MinVer's tag-derived version via `MinVerVersionOverride` when needed.
  -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <Authors>Pekka Heikura</Authors>
    <Company>Ahjo</Company>
    <Product>Ahjo.Vulkan</Product>
    <Copyright>Copyright (c) Pekka Heikura</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/pekkah/Ahjo-Vulkan</PackageProjectUrl>
    <RepositoryUrl>https://github.com/pekkah/Ahjo-Vulkan</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>vulkan;graphics;gpu;interop;native</PackageTags>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <Deterministic>true</Deterministic>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <!--
    Package READMEs live next to each packable csproj
    (src/Ahjo.Vulkan/README.md + src/Ahjo.Vulkan.Native/README.md). The
    repo-root README.md stays contributor-focused and doesn't ship in
    either nupkg.

    LICENSE is shipped at the nupkg root alongside the SPDX
    PackageLicenseExpression. The expression drives nuget.org's license
    rendering; the bundled file satisfies SBOM / OSS-scanning tools that
    grep nupkgs for a license file without round-tripping to nuget.org.
  -->
  <ItemGroup Condition="'$(IsPackable)' == 'true'">
    <None Include="$(MSBuildThisFileDirectory)LICENSE" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

</Project>
