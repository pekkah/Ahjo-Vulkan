<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <!--
    ClangSharpPInvokeGenerator is consumed as a dotnet tool (see
    .config/dotnet-tools.json); the tool bundles the libclang natives
    for all supported RIDs, so no per-OS runtime packages are needed.
  -->

  <ItemGroup>
    <PackageVersion Include="xunit.v3" Version="4.0.3" />
    <PackageVersion Include="Microsoft.Testing.Extensions.CrashDump" Version="2.5.3" />
  </ItemGroup>

  <!-- Derives package version from git tags + commit height; see
       Directory.Build.props and .github/workflows/publish.yml. -->
  <ItemGroup>
    <PackageVersion Include="MinVer" Version="8.0.0" />
  </ItemGroup>

  <!-- Window/surface integration for tests (Wayland/Metal E2E surface
       coverage) and the windowed samples. ppy.SDL3-CS is the osu!
       framework's binding: 1-3 week release cadence, MIT-licensed,
       ships bundled SDL3 native binaries for win/linux/macOS via
       runtimes/<rid>/native/. -->
  <ItemGroup>
    <PackageVersion Include="ppy.SDL3-CS" Version="2026.1002.1" />
  </ItemGroup>

  <!-- Test-only ETW consumer: Ahjo.Vulkan.Tests' PclStatsEtwRoundTripTests
       opens a real-time session on the PCL Stats provider and decodes its
       TraceLogging events (issue #261). Never referenced from src/. -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.Diagnostics.Tracing.TraceEvent" Version="4.0.0" />
  </ItemGroup>

  <!-- On-demand allocation + latency benchmarks. See
       tests/Ahjo.Vulkan.Benchmarks/ for usage. Preview because 0.15.8, the
       latest stable, cannot launch a net11.0 job (RuntimeMoniker
       NotRecognized); move back to stable once 0.16.0 ships. -->
  <ItemGroup>
    <PackageVersion Include="BenchmarkDotNet" Version="0.16.0-preview.2" />
  </ItemGroup>

</Project>
